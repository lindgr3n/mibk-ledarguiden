---
import '@fontsource/roboto-slab/latin-700.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
import '../styles/components.css';

import { getActiveSeason } from '../lib/nivaguide';

interface Props {
	title: string;
	// Säsongsetikett i sidfoten. Utan den används den aktiva säsongen; arkivsidor anger sin egen.
	seasonLabel?: string;
	// Startsidan har det höga huvudet med ordmärke (referensbilden landingpage.png).
	variant?: 'home';
}

const { title, seasonLabel = (await getActiveSeason()).data.label, variant } = Astro.props;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} – Moälvens ledarguide`;

// Huvudmenyn: exakt dessa fyra val, i den här ordningen.
const menu = [
	{ label: 'Hem', href: '/' },
	{ label: 'Nivåer', href: '/nivaer/' },
	{ label: 'Matchdagen', href: '/matchdagen/' },
	{ label: 'Regler och dokument', href: '/regler/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#innehall">Hoppa till innehållet</a>
		<header class:list={['site-header', { 'site-header-home': variant === 'home' }]}>
			<div class="header-inner">
				<a class="brand" href="/">
					<img src="/images/brand/moalvens-ibk-logo.png" alt="Moälvens IBK, till startsidan" width="112" height="112" />
					{
						variant === 'home' && (
							<span class="wordmark" aria-hidden="true">
								<span class="wordmark-name">Moälvens IBK</span>
								<span class="wordmark-sub">Innebandy | Västernorrland</span>
							</span>
						)
					}
				</a>
				<nav aria-label="Huvudmeny">
					<ul>
						{
							menu.map((item) => (
								<li>
									<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<main id="innehall" tabindex="-1">
			<slot name="hero" />
			<div class="wrap content">
				<slot />
			</div>
		</main>
		<footer class="site-footer">
			<div class="wrap">Moälvens IBK · Ledarguide {seasonLabel}</div>
		</footer>
	</body>
</html>
