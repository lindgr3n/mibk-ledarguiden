---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';

import { getActiveSeason } from '../lib/nivaguide';

interface Props {
	title: string;
	// Säsongsetikett i sidfoten. Utan den används den aktiva säsongen; arkivsidor anger sin egen.
	seasonLabel?: string;
}

const { title, seasonLabel = (await getActiveSeason()).data.label } = Astro.props;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} – Moälvens ledarguide`;

// Huvudmenyn: exakt dessa fyra val, i den här ordningen.
const menu = [
	{ label: 'Hem', href: '/' },
	{ label: 'Nivåer', href: '/nivaer/' },
	{ label: 'Matchdagen', href: '/matchdagen/' },
	{ label: 'Regler och dokument', href: '/regler/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#innehall">Hoppa till innehållet</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="brand" href="/">
					<img src="/images/brand/moalvens-ibk-logo.png" alt="" width="40" height="40" />
					<span>Moälvens ledarguide</span>
				</a>
				<nav aria-label="Huvudmeny">
					<ul>
						{
							menu.map((item) => (
								<li>
									<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<main id="innehall" class="wrap" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap">Moälvens IBK · Ledarguide {seasonLabel}</div>
		</footer>
	</body>
</html>
