---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getActiveSeason, getLevelOverview } from '../lib/nivaguide';

const levels = await getLevelOverview();
const season = await getActiveSeason();
---

<Layout title="Nivåer">
	<Fragment slot="hero">
		<Hero variant="detail" labelledby="nivaer-h1">
			<p class="eyebrow">Moälvens innebandy · Säsong {season.data.label}</p>
			<h1 id="nivaer-h1"><span class="lvl-word-neutral">Nivåer</span></h1>
			<p class="hero-lead">Välj nivå för att se vad som gäller i din division.</p>
		</Hero>
	</Fragment>
	<ul class="card nivaer-list">
		{
			levels.map((level) => (
				<li>
					{level.href ? <a href={level.href}>{level.name}</a> : level.name} – {level.divisions}
					{!level.href && <> · {level.state}</>}
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.nivaer-list {
		margin: 1.25rem 0 0;
		list-style: none;
		font-size: 1.25rem;
	}
</style>
