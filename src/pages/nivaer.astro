---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LevelCard from '../components/LevelCard.astro';
import { getActiveSeason, getLevelOverview } from '../lib/nivaguide';

const levels = await getLevelOverview();
const season = await getActiveSeason();
---

<Layout title="Nivåer">
	<Fragment slot="hero">
		<Hero variant="detail" labelledby="nivaer-h1">
			<p class="eyebrow">Moälvens innebandy · Säsong {season.data.label}</p>
			<h1 id="nivaer-h1"><span class="lvl-word-neutral">Nivåer</span></h1>
			<p class="hero-lead">Välj nivå för att se vad som gäller i din division.</p>
		</Hero>
	</Fragment>
	<ul class={`level-cards${levels.length > 3 ? ' level-cards-4' : ''}`}>
		{
			levels.map((level) => (
				<LevelCard
					niva={level.key}
					titel={level.name}
					href={level.href}
					knapp={level.href ? `Gå till ${level.name.toLowerCase()}` : level.state}
					rubrik="h2"
				>
					{level.divisions}
				</LevelCard>
			))
		}
	</ul>
</Layout>
