---
import Layout from '../layouts/Layout.astro';
import { getLevelOverview } from '../lib/nivaguide';

const levels = await getLevelOverview();
---

<Layout title="Nivåer">
	<h1>Nivåer</h1>
	<p>Välj nivå för att se vad som gäller i din division.</p>
	<ul>
		{
			levels.map((level) => (
				<li>
					{level.href ? <a href={level.href}>{level.name}</a> : level.name} – {level.divisions}
					{!level.href && <> · {level.state}</>}
				</li>
			))
		}
	</ul>
</Layout>
