---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { getActiveSeason, getArchivedSeasons, getLevelOverview } from '../lib/nivaguide';

// Startsidan visar den aktiva säsongen (ADR 0001).
const season = await getActiveSeason();
const levels = await getLevelOverview();
const archivedSeasons = (await getArchivedSeasons()).sort((a, b) => b.id.localeCompare(a.id));
const archiveLevels = levels.filter((l) => l.href);

// Bra matchmiljö: definitionen ägs av Regler och dokument.
const content = (await getCollection('reglerochdokument')).find((c) => c.data.season.id === season.id);
if (!content) throw new Error(`Inget innehåll för Regler och dokument i säsong ${season.data.label}`);
const { definition } = content.data.matchEnvironment;
const { news } = content.data;
---

<Layout title={`Ledarguide ${season.data.label}`} variant="home">
	<Fragment slot="hero">
		<Hero variant="home" labelledby="hero-title" imageAlt="Innebandyklubba och boll på hallgolvet">
			<p class="eyebrow">Välkommen till</p>
			<h1 id="hero-title">
				Moälvens IBK –{' '}<br /><span class="accent">Ledarguide</span> {season.data.label}
			</h1>
			<p class="hero-lead">Välj nivå för att hitta rätt information för ditt lag och dina matcher.</p>
		</Hero>
	</Fragment>

	<section id="valj-niva" aria-labelledby="valj-niva-title">
		<h2 id="valj-niva-title" class="visually-hidden">Välj nivå</h2>
		<ul class="level-cards">
			{
				levels.map((level) => (
					<li class={`level-card level-card-${level.key}`}>
						<Icon name="users" size={44} />
						<h3>{level.name}</h3>
						<p>{level.divisions}</p>
						{level.href ? (
							<a class="btn-white" href={level.href}>
								Gå till {level.name.toLowerCase()}
								<Icon name="arrow" size={20} />
							</a>
						) : (
							<span class="btn-white is-disabled">{level.state}</span>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<div class="panel-row">
		<section class="card panel" aria-labelledby="nya-regler-title">
			<Icon name="doc" size={56} />
			<div>
				<h2 id="nya-regler-title">Nya regler {season.data.label}</h2>
				<p>{news.summary} Här hittar du en kort sammanfattning av vad som är nytt inför säsongen {season.data.label}.</p>
			</div>
			<a class="link-arrow" href="/regler/#nyheter">Till nya regler <Icon name="arrow" size={18} /></a>
		</section>

		<section class="card panel" aria-labelledby="dokument-title">
			<Icon name="book" size={56} />
			<div>
				<h2 id="dokument-title">Officiella dokument</h2>
				<p>
					Hitta rätt bland förbundets regler, direktiv och dokument. Här är de viktigaste länkarna för dig som
					ledare i Moälvens IBK.
				</p>
			</div>
			<a class="link-arrow" href="/regler/">Visa dokument <Icon name="arrow" size={18} /></a>
		</section>
	</div>

	<div class="panel-row">
		<section class="card panel" aria-labelledby="matchdagen-title">
			<Icon name="calendar" size={56} />
			<div>
				<h2 id="matchdagen-title">Matchdagen</h2>
				<p>Checklistan inför och under matchen, från samling till matchflytt.</p>
			</div>
			<a class="link-arrow" href="/matchdagen/">Öppna Matchdagen <Icon name="arrow" size={18} /></a>
		</section>

		<section class="card panel" aria-labelledby="matchmiljo-title">
			<Icon name="users" size={56} />
			<div>
				<h2 id="matchmiljo-title">Bra matchmiljö</h2>
				<p>{definition}</p>
			</div>
			<a class="link-arrow" href="/regler/#matchmiljo">Förbundets material om bra matchmiljö <Icon name="arrow" size={18} /></a>
		</section>
	</div>

	<section aria-labelledby="arkiv-title" class="archive-teaser">
		<h2 id="arkiv-title">Tidigare säsonger</h2>
		{
			archivedSeasons.length > 0 ? (
				<ul class="archive-list">
					{archivedSeasons.map((s) => (
						<li>
							<strong>Säsong {s.data.label}</strong>:{' '}
							{archiveLevels.map((l, i) => (
								<>
									{i > 0 && ' · '}
									<a href={`/sasonger/${s.id}/${l.key}/`}>{l.name}</a>
								</>
							))}
						</li>
					))}
				</ul>
			) : (
				<p>Kommer när nästa säsong publiceras. Då sparas {season.data.label} som ett arkiv.</p>
			)
		}
	</section>
</Layout>
