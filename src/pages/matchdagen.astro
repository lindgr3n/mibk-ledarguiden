---
import ExternalLink from '../components/ExternalLink.astro';
import SourceRef from '../components/SourceRef.astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getActiveSeason } from '../lib/nivaguide';
import { ruleTypes } from '../lib/regelhierarki';

// Matchdagen för den aktiva säsongen (ADR 0001).
const season = await getActiveSeason();
const entry = (await getCollection('matchdagen')).find((m) => m.data.season.id === season.id);
if (!entry) throw new Error(`Ingen Matchdagen för säsong ${season.data.label}`);
const { sections, relocation, readMore } = entry.data;
// Förklaringen av föreningsvägledning visas en gång på sidan, inte under varje punkt.
const usesGuidance = sections.some((sec) => sec.items.some((i) => i.ruleSource === 'foreningsvagledning'));

---

<Layout title="Matchdagen">
	<Fragment slot="hero">
		<Hero variant="detail" labelledby="matchdagen-h1">
			<p class="eyebrow">Moälvens innebandy · Säsong {season.data.label}</p>
			<h1 id="matchdagen-h1"><span class="lvl-word-neutral">Match</span>dagen</h1>
			<p class="hero-lead">Checklista för ledare: inför, under och efter match.</p>
		</Hero>
	</Fragment>
	<div class="card-page">
		<nav aria-label="Genvägar på sidan" class="shortcuts">
			<ul>
				{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
				<li><a href="#matchflytt">{relocation.title}</a></li>
			</ul>
		</nav>

		{
			usesGuidance && (
				<p class="rule-note">
					<span class="rule-tag rule-foreningsvagledning">
						<span class="rule-label">{ruleTypes.foreningsvagledning.label}</span>
					</span>{' '}
					{ruleTypes.foreningsvagledning.description}
				</p>
			)
		}

		{
			sections.map((s) => (
				<section id={s.id} aria-labelledby={`h-${s.id}`} class="checklist-section">
					<h2 id={`h-${s.id}`}>{s.title}</h2>
					<ul class="checklist">
						{s.items.map((item) => (
							<li data-item={item.id}>
								<span class="item-text">{item.text}</span>
								<span class={`rule-tag rule-${item.ruleSource}`}>
									<span class="rule-label">{ruleTypes[item.ruleSource].label}</span>
								</span>
								{item.source && item.checked && (
									<span class="provenance">
										<span class="provenance-source">
											<SourceRef source={item.source} />
										</span>
										<span class="provenance-checked">Kontrollerad {item.checked}</span>
									</span>
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}

		<section id="matchflytt" aria-labelledby="h-matchflytt" class="checklist-section">
			<h2 id="h-matchflytt">{relocation.title}</h2>
			<p>{relocation.intro}</p>
			<p><ExternalLink href={relocation.link.url}>{relocation.link.label}</ExternalLink></p>
			<p>{relocation.reminder}</p>
		</section>

		<section aria-labelledby="h-lasmer" class="checklist-section">
			<h2 id="h-lasmer">Läs mer</h2>
			<ul>
				{readMore.map((l) => <li><ExternalLink href={l.url}>{l.label}</ExternalLink></li>)}
			</ul>
		</section>
	</div>
</Layout>
