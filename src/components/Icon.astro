---
// Linjeikoner (24 × 24) som följer referensbilderna. Dekorativa: betydelsen står alltid i intilliggande text.
export type IconName =
	| 'users'
	| 'clock'
	| 'swap'
	| 'court'
	| 'goal'
	| 'chart'
	| 'doc'
	| 'trophy'
	| 'megaphone'
	| 'calendar'
	| 'book'
	| 'arrow'
	| 'chevron'
	| 'external'
	| 'back';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 24 } = Astro.props;

const paths: Record<IconName, string[]> = {
	users: [
		'M9 11a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z',
		'M2.8 19.5c0-3.2 2.7-5.3 6.2-5.3s6.2 2.1 6.2 5.3',
		'M16.6 10.6a2.6 2.6 0 1 0 0-5.2',
		'M17 14.4c2.4.3 4.2 2 4.2 5',
	],
	clock: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M12 7v5.2l3.4 2'],
	swap: ['M4 8h15', 'M15.5 4.5 19 8l-3.5 3.5', 'M20 16H5', 'M8.5 12.5 5 16l3.5 3.5'],
	court: ['M3 6.5h18v11H3z', 'M12 6.5v11', 'M12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z', 'M3 10h3v4H3', 'M21 10h-3v4h3'],
	goal: ['M4 7h16v11H4z', 'M9.3 7v11', 'M14.7 7v11', 'M4 12.5h16'],
	chart: ['M6 20v-6', 'M12 20V8', 'M18 20V4'],
	doc: ['M7 3h7l4 4v14H7z', 'M14 3v4h4', 'M9.6 12h6', 'M9.6 15.5h6'],
	trophy: [
		'M8 4h8v5a4 4 0 0 1-8 0z',
		'M8 6H5v1.5A3 3 0 0 0 8 10.5',
		'M16 6h3v1.5a3 3 0 0 1-3 3',
		'M12 13v4',
		'M10 17h4',
		'M8.5 20h7',
	],
	megaphone: ['M4 10v4l10 4V6z', 'M14 8.5a3.5 3.5 0 0 1 0 7', 'M6.4 15l1 4.5h2.6l-1-4'],
	calendar: ['M5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12A1.5 1.5 0 0 1 5.5 5z', 'M4 10h16', 'M8 3v4', 'M16 3v4'],
	book: ['M12 6.2C10 4.7 7 4.2 4 4.7v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5z', 'M12 6.2v13'],
	arrow: ['M5 12h14', 'M13 6l6 6-6 6'],
	chevron: ['M9 5l7 7-7 7'],
	external: ['M14 4h6v6', 'M20 4l-9 9', 'M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5'],
	back: ['M19 12H5', 'M11 6l-6 6 6 6'],
};
---

<svg
	class={`icon icon-${name}`}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{paths[name].map((d) => <path d={d} />)}
</svg>
