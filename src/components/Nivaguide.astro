---
// Gemensam vy för en nivåguide (Röd, Blå, ...): hero, divisionsflikar, snabb översikt, sidokolumn,
// divisionsanpassningar, uppdateringsnotiser och regelhierarki (referensbild rod_detail.png).
// Sidorna anger bara vilken nivå som ska visas.
import ExternalLink from './ExternalLink.astro';
import SourceRef from './SourceRef.astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Icon from './Icon.astro';
import UpdateNotices from './UpdateNotices.astro';
import FactList from './FactList.astro';
import { SPELUTBILDNING_URL } from '../lib/lankar';
import {
	describeDivisionRange,
	describeDivisions,
	divisionNumbers,
	getActiveGuide,
	getSeasonById,
	getSeasonGuide,
	type Level,
} from '../lib/nivaguide';
import { factIcon, splitLevelName } from '../lib/presentation';
import { ruleTypes } from '../lib/regelhierarki';

interface Props {
	level: Level;
	// Id för en arkiverad säsong (t.ex. 2026-2027). Utan den visas den aktiva säsongen.
	seasonId?: string;
}

const { level, seasonId } = Astro.props;
const { guide, season, factGroups, unverifiedDivisions, divisionAdaptations } = seasonId
	? await getSeasonGuide(await getSeasonById(seasonId), level)
	: await getActiveGuide(level);
const archived = season.status === 'arkiverad';

const { word, rest: restOfName } = splitLevelName(guide.name);
const hasDivisions = Boolean(guide.divisions);
const levelDivisions = divisionNumbers(guide.divisions);
const verifiedText = hasDivisions
	? describeDivisions([...new Set(factGroups.flatMap((g) => g.appliesTo))]).toLowerCase()
	: '';
const bandTitle = guide.spelformKort ?? guide.name;
// Länkar till spelutbildningen lagras som sökväg och får adressen här.
const lankHref = (l: { url?: string; spelutbildning?: string }) => l.url ?? `${SPELUTBILDNING_URL}${l.spelutbildning}`;
const bandMeta = [guide.name, guide.undertitel, guide.alder].filter(Boolean).join(' · ');

// Sidokolumnen (nytt, dokument, Matchdagen) hör till den aktiva säsongen och visas inte i arkivet.
const activeSeason =
	archived || !hasDivisions ? undefined : (await getCollection('sasonger')).find((s) => s.data.label === season.label);
const rules = activeSeason
	? (await getCollection('reglerochdokument')).find((c) => c.data.season.id === activeSeason.id)?.data
	: undefined;
const matchday = activeSeason
	? (await getCollection('matchdagen')).find((m) => m.data.season.id === activeSeason.id)?.data
	: undefined;
// Viktiga dokument: säsongens (regelbok, matris, lokala förutsättningar) eller nivåns egna om den saknar matcher.
const docs = hasDivisions
	? (rules?.documents ?? []).map((d) => ({ label: d.title, href: d.url }))
	: (guide.documents ?? []).map((d) => ({ label: d.label, href: lankHref(d) }));
// Antal punkter på nivåns matchdag (punkter utan `levels` gäller alla nivåer).
const matchdayPoints = matchday
	? matchday.sections.reduce((n, sec) => n + sec.items.filter((i) => !i.levels || i.levels.includes(level as 'gron' | 'bla' | 'rod')).length, 0)
	: 0;
---

<Layout seasonLabel={season.label} title={archived ? `${guide.name} – arkiv ${season.label}` : guide.name} tema={level}>
	<Fragment slot="hero">
		<Hero variant="detail" labelledby="level-title">
			<p class="eyebrow">Moälvens innebandy · Säsong {season.label}</p>
			<h1 id="level-title"><span class={`lvl-word-${level}`}>{word}</span> {restOfName}</h1>
			<p class="hero-sub">{guide.divisions ? describeDivisionRange(guide.divisions) : guide.alder}</p>
			<p class="hero-lead">
				{
					guide.divisions
						? `${guide.name} omfattar ${describeDivisionRange(guide.divisions).toLowerCase()} i Västernorrlands ungdomsserier. Här hittar du de viktigaste matchfakta, spelformerna och praktisk information för ledare.`
						: `${guide.name} är Moälvens lek- och rörelsegrupp, utan matcher och utan divisioner. Här hittar du hur starten går till och vad barnet behöver.`
				}
			</p>
		</Hero>
	</Fragment>

	{
		archived && (
			<aside class="archive-banner" role="note" aria-label="Arkiv">
				<strong>Arkiv – gällde säsong {season.label}</strong>
				<p>
					Det här är en oföränderlig kopia av vad som gällde då. Använd den inte inför match.{' '}
					<a href={`/${level}/`}>Gå till aktuell säsong</a>
				</p>
			</aside>
		)
	}

	{
		!archived && !hasDivisions && guide.topTile && (
			<ul class="division-tiles" aria-label={`Genväg för ${guide.name.toLowerCase()}`}>
				<li>
					<ExternalLink class="division-tile" href={`${SPELUTBILDNING_URL}${guide.topTile.spelutbildning}`}>
						<Icon name="users" size={34} />
						<span class="tile-text">
							<strong>{guide.topTile.title}</strong>
							<span>{guide.topTile.sub}</span>
						</span>
						<Icon name="external" size={18} />
					</ExternalLink>
				</li>
			</ul>
		)
	}

	{
		!archived && hasDivisions && (
			<ul class="division-tiles" aria-label={`Divisioner i ${guide.name.toLowerCase()}`}>
				{levelDivisions.map((n) => (
					<li>
						<a class="division-tile" href={`#division-${n}`}>
							<Icon name="trophy" size={34} />
							<span class="tile-text">
								<strong>Division {n}</strong>
								<span>{guide.name}</span>
							</span>
							<Icon name="chevron" size={18} />
						</a>
					</li>
				))}
			</ul>
		)
	}

	{
		rules && (
			<section class="card news-card news-wide" aria-labelledby="nytt-title">
				<div class="side-head">
					<Icon name="megaphone" size={44} />
					<h2 id="nytt-title">{rules.news.title}</h2>
				</div>
				<p>{rules.news.summary} Här hittar du en sammanfattning av de viktigaste förändringarna.</p>
				<a class="link-arrow link-end" href="/regler/#nyheter">
					Läs mer <Icon name="arrow" size={18} />
				</a>
			</section>
		)
	}

	<section class={`card overview sheet sheet-${level}`} aria-labelledby="matchfakta" id="snabb-oversikt">
		<header class="sheet-band">
			<div class="sheet-band-text">
				<p class="sheet-format">{bandTitle}</p>
				<p class="sheet-meta">{bandMeta}</p>
			</div>
			<img class="sheet-logo" src="/images/brand/moalvens-ibk-logo.png" alt="Moälvens IBK" width="112" height="112" />
		</header>
		<div class="sheet-body">
			<div class="overview-head">
				<div>
					<h2 id="matchfakta">Snabb översikt</h2>
					<p class="card-sub">
						{
							hasDivisions
								? `Detta gäller på ${guide.name.toLowerCase()} – verifierat för ${verifiedText}`
								: `Så fungerar ${guide.name.toLowerCase()} i Moälvens IBK`
						}
					</p>
				</div>
			</div>
			{
				unverifiedDivisions.length > 0 && (
					<p class="notice">
						Uppgifterna nedan är verifierade för {verifiedText}. {describeDivisions(unverifiedDivisions)} är inte
						verifierade ännu – kontrollera originalkällan.
					</p>
				)
			}
			<ul class="fact-rows fact-rows-2 fact-rows-sheet">
				{
					factGroups.flatMap((group) =>
						group.facts.map((fact) => (
							<li class="fact-row" data-fact={fact.key}>
								<span class="fact-icon">
									<Icon name={factIcon(fact.key)} size={26} />
								</span>
								<div>
									<strong>{fact.label}</strong>
									<span class="fact-value">{fact.value}</span>
								</div>
							</li>
						)),
					)
				}
			</ul>
		</div>
	</section>

	{
		!archived && docs.length > 0 && (
			<div class="side-pair level-extras">
				<section class="card no-print" aria-labelledby="dokument-title">
					<div class="side-head">
						<Icon name="doc" size={40} />
						<div>
							<h3 id="dokument-title">Viktiga dokument</h3>
							<p class="card-sub">Regler, bestämmelser och information</p>
						</div>
					</div>
					<ul class="doc-links">
						{docs.map((doc) => (
							<li>
								<ExternalLink href={doc.href}>
									{doc.label}
									<Icon name="external" size={16} />
								</ExternalLink>
							</li>
						))}
					</ul>
				</section>

				{guide.startCard && (
					<section class="card start-card no-print" aria-labelledby="uppstart-title">
						<div class="side-head">
							<Icon name="users" size={40} />
							<div>
								<h3 id="uppstart-title">{guide.startCard.title}</h3>
								<p class="card-sub">{guide.startCard.sub}</p>
							</div>
						</div>
						<p>{guide.startCard.text}</p>
						<ExternalLink class="link-arrow link-end" href={`${SPELUTBILDNING_URL}${guide.startCard.spelutbildning}`}>
							{guide.startCard.linkLabel} <Icon name="external" size={16} />
						</ExternalLink>
					</section>
				)}
				{matchday && (
				<section class="card matchday-card no-print" aria-labelledby="matchdagen-side-title">
					<div class="side-head">
						<Icon name="calendar" size={40} />
						<div>
							<h3 id="matchdagen-side-title">Matchdagen</h3>
							<p class="card-sub">Checklista för ledare</p>
						</div>
					</div>
					<p>
						Inför, under och efter match: licens, laguppställning, matchvärdar, sekretariat och vad du gör om matchen
						behöver flyttas. {matchdayPoints} punkter på en egen sida.
					</p>
					<a class="link-arrow link-end" href={`/${level}/matchdagen/`}>
						Öppna matchdagens checklista <Icon name="arrow" size={18} />
					</a>
				</section>
				)}
			</div>
		)
	}

	{
		!archived && (
			<section class="card train-card no-print" aria-labelledby="trana-title">
				<div class="side-head">
					<Icon name="book" size={40} />
					<div>
						<h3 id="trana-title">Så tränar vi</h3>
						<p class="card-sub">Spelidé, principer, övningar och träningspass för {guide.name.toLowerCase()}</p>
					</div>
				</div>
				<ExternalLink class="link-arrow" href={`${SPELUTBILDNING_URL}/nivaer/${level}/`}>
					Till spelutbildningen <Icon name="external" size={16} />
				</ExternalLink>
			</section>
		)
	}

	<div class="level-more">
		{
			hasDivisions && (
				<section aria-labelledby="divisionsanpassningar" class={`division-adaptations sheet-${level}`}>
					<h2 id="divisionsanpassningar">Divisionsanpassningar</h2>
					<p>
						Det som skiljer divisionerna åt. Allt annat gäller {guide.name.toLowerCase()} i sin helhet enligt
						översikten ovan.
					</p>
					<div class="division-cards">
						{levelDivisions.map((n) => {
							const d = divisionAdaptations.find((x) => x.division === n);
							const differs = d && (d.adaptations.length > 0 || d.unverified.length > 0);
							return (
								<section class="division card" id={`division-${n}`} data-division={n} aria-labelledby={`d-${n}`}>
									<h3 id={`d-${n}`}>Division {n}</h3>
									{!differs && <p class="no-diff">Inga avvikelser från {guide.name.toLowerCase()}.</p>}
									{d?.adaptations.map((a) => (
										<div class="fact-group" data-adaptation={a.id}>
											<h4>{a.title}</h4>
											<ul class="fact-rows fact-rows-sheet">
												{a.facts.map((f) => (
													<li class="fact-row" data-fact={f.key}>
														<span class="fact-icon">
															<Icon name={factIcon(f.key)} size={26} />
														</span>
														<div>
															<strong>{f.label}</strong>
															<span class="fact-value">{f.value}</span>
														</div>
													</li>
												))}
											</ul>
											<p class="provenance">
												{a.ruleSource && (
													<>
														<span class="rule-label">{ruleTypes[a.ruleSource].label}</span> ·{' '}
													</>
												)}
												Gäller division {n} · Kontrollerad {a.checked} · <SourceRef source={a.source} />
											</p>
										</div>
									))}
									{d?.unverified.map((u) => (
										<div class="fact-group unverified" data-unverified-adaptation={u.id}>
											<h4>{u.title} – ej verifierat</h4>
											<p class="notice">{u.note}</p>
										</div>
									))}
								</section>
							);
						})}
					</div>
				</section>
			)
		}

		<UpdateNotices notices={guide.updateNotices} />
	</div>

	<section class="card level-more" aria-labelledby="kallor-title">
		<h2 id="kallor-title">Källor och kontrolldatum</h2>
		<ul class="sources-list">
			{
				factGroups.map((group) => (
					<li data-fact-group={group.id}>
						<strong>{group.title}</strong> ·{' '}
						{group.ruleSource && (
							<>
								<span class="rule-label">{ruleTypes[group.ruleSource].label}</span> ·{' '}
							</>
						)}
						Gäller {group.appliesTo.length > 0 ? describeDivisions(group.appliesTo).toLowerCase() : 'hela nivån'} · Kontrollerad{' '}
						{group.checked} ·{' '}
						<SourceRef source={group.source} />
					</li>
				))
			}
		</ul>
	</section>
</Layout>
